# ---- Secrets: environment ----
.env
.env.*
*.env

# ---- Secrets: app config (never commit real config; keep the example) ----
config.php
**/config.php
!config.php.example

# ---- Secrets: certificates / keys ----
*.pem
**/*.pem
*.key
*.crt

# ---- Local compose overrides (may contain env/secrets) ----
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml