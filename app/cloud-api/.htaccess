RewriteEngine On
RewriteBase /nb/cloud-api/

SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# CORS: public browser-facing API. A wildcard origin is only valid without
# credentials — never allow credentialed requests alongside it.
Header set Access-Control-Allow-Origin "*"
Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
# The parent /nb/ .htaccess sets a credential-allowing CORS header, which is
# invalid next to a wildcard origin. Unset it here (child merge runs after
# the parent's set) so this API never advertises credentials.
Header unset Access-Control-Allow-Credentials
Header always unset Access-Control-Allow-Credentials

# CORS preflight (OPTIONS -> 204, no auth) is answered by index.php before
# its auth gate. Deliberately NOT done with a mod_rewrite [R=204] rule here:
# R-status responses bypass the Header set lines above, shipping a preflight
# with no CORS headers, which browsers reject.

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

AddDefaultCharset UTF-8
Options -Indexes

Header set X-Content-Type-Options "nosniff"
Header set X-XSS-Protection "1; mode=block"
Header set X-Frame-Options "SAMEORIGIN"

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript application/json
</IfModule>